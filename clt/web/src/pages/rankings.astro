---
import Base from "../layouts/Base.astro";
import { latestWeek, loadWeekFile } from "../lib/week";

type Row = {
  Team: string;
  Record: string;
  PF: number;
  PA: number;
  FVOA: number;
  "FVOA Rank": number;
  "Yahoo Rank": number;
  "SOR Rank": number;
};

const { week } = latestWeek();
const rows = loadWeekFile<Row[]>("rankings").sort((a, b) => a["FVOA Rank"] - b["FVOA Rank"]);

const sorts = [
  { key: "fvoa", label: "FVOA" },
  { key: "yahoo", label: "Yahoo" },
  { key: "sor", label: "Strength of record" },
  { key: "pf", label: "Points for" },
];
const n = (v: number) => Math.round(v).toLocaleString("en-US");
---

<Base title="Rankings · Charlotte's Finest">
  <header class="mb-4 flex items-baseline justify-between">
    <h1 class="text-lg font-semibold">Power rankings</h1>
    <p class="text-xs text-slate-500 dark:text-slate-400">Week {week}</p>
  </header>

  <div class="mb-3 flex flex-wrap gap-2">
    {
      sorts.map((s) => (
        <button
          data-sort={s.key}
          aria-pressed={s.key === "fvoa"}
          class="rounded-full bg-slate-200 px-3 py-1 text-xs font-medium text-slate-700 aria-pressed:bg-indigo-600 aria-pressed:text-white dark:bg-slate-800 dark:text-slate-300"
        >
          {s.label}
        </button>
      ))
    }
  </div>

  <div class="overflow-x-auto rounded-2xl bg-white shadow-sm dark:bg-slate-900">
    <table class="w-full text-sm tabular-nums">
      <thead class="text-left text-xs text-slate-500 dark:text-slate-400">
        <tr>
          <th class="px-3 py-3">#</th>
          <th class="py-3">Team</th>
          <th class="py-3">Rec</th>
          <th class="py-3 text-right">FVOA</th>
          <th class="py-3 text-right">PF</th>
          <th class="py-3 text-right">PA</th>
          <th class="py-3 text-right">Yahoo</th>
          <th class="px-3 py-3 text-right">SOR</th>
        </tr>
      </thead>
      <tbody id="rows">
        {
          rows.map((r, i) => (
            <tr
              data-fvoa={r["FVOA Rank"]}
              data-yahoo={r["Yahoo Rank"]}
              data-sor={r["SOR Rank"]}
              data-pf={-r.PF}
              class="border-t border-slate-100 dark:border-slate-800"
            >
              <td class="pos px-3 py-3 text-slate-400">{i + 1}</td>
              <td class="py-3 font-medium">{r.Team}</td>
              <td class="py-3">{r.Record}</td>
              <td class="py-3 text-right">{r.FVOA.toFixed(2)}</td>
              <td class="py-3 text-right">{n(r.PF)}</td>
              <td class="py-3 text-right">{n(r.PA)}</td>
              <td class="py-3 text-right">{r["Yahoo Rank"]}</td>
              <td class="px-3 py-3 text-right">{r["SOR Rank"]}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="mt-3 text-xs leading-relaxed text-slate-500 dark:text-slate-400">
    FVOA is a team's expected margin against a historically average team. SOR (strength of record)
    is how impressive the record is given the schedule played.
  </p>
</Base>

<script>
  const body = document.querySelector<HTMLElement>("#rows")!;
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-sort]");

  function sortBy(key: string) {
    const rows = [...body.querySelectorAll<HTMLTableRowElement>("tr")];
    rows.sort((a, b) => Number(a.dataset[key]) - Number(b.dataset[key]));
    rows.forEach((row, i) => {
      body.appendChild(row);
      row.querySelector(".pos")!.textContent = String(i + 1);
    });
    buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.sort === key)));
  }

  buttons.forEach((b) => b.addEventListener("click", () => sortBy(b.dataset.sort!)));
</script>