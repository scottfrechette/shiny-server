---
import Base from "../layouts/Base.astro";
import { loadWeekFile, pct } from "../lib/week";

type Game = {
  week: number;
  winner: string;
  loser: string;
  winner_win_prob: number;
  loser_win_prob: number;
  spread: number;
  moneyline: number;
  quality: number;
  importance: number;
  overall: number;
};

// "winner" in the data is just the listed side of each game and can be under
// 50%. Put whichever team has the higher win probability on the left, and flip
// the spread so it is always from the left team's point of view.
const games = loadWeekFile<Game[]>("matchups")
  .map((g) => {
    const flip = g.winner_win_prob < g.loser_win_prob;
    return flip
      ? { ...g, left: g.loser, right: g.winner, leftProb: g.loser_win_prob, rightProb: g.winner_win_prob, leftSpread: -g.spread }
      : { ...g, left: g.winner, right: g.loser, leftProb: g.winner_win_prob, rightProb: g.loser_win_prob, leftSpread: g.spread };
  })
  .sort((a, b) => b.overall - a.overall); // biggest game first

const week = games[0]?.week;

const spreadLabel = (g: (typeof games)[number]) =>
  g.leftSpread === 0 ? "Pick'em" : `${g.left} ${g.leftSpread > 0 ? "+" : ""}${g.leftSpread}`;
---

<Base title="Week · Charlotte's Finest">
  <header class="mb-4 flex items-baseline justify-between">
    <h1 class="text-lg font-semibold">Week {week} matchups</h1>
    <p class="text-xs text-slate-500 dark:text-slate-400">Win probability</p>
  </header>

  <ul class="space-y-3">
    {
      games.map((g, i) => (
        <li class="rounded-2xl bg-white p-4 shadow-sm dark:bg-slate-900">
          {i === 0 && (
            <p class="mb-2 text-xs font-semibold text-indigo-600 dark:text-indigo-400">
              Game of the Week
            </p>
          )}
          <div class="flex items-baseline justify-between text-sm font-medium">
            <span>{g.left}</span>
            <span class="text-xs font-normal text-slate-400">vs</span>
            <span>{g.right}</span>
          </div>
          <div class="my-2 flex h-2 overflow-hidden rounded-full bg-slate-100 dark:bg-slate-800">
            <span class="bg-indigo-500" style={`width:${g.leftProb * 100}%`} />
          </div>
          <div class="flex justify-between text-sm font-semibold tabular-nums">
            <span>{pct(g.leftProb)}</span>
            <span>{pct(g.rightProb)}</span>
          </div>
          <p class="mt-3 text-xs text-slate-500 tabular-nums dark:text-slate-400">
            {spreadLabel(g)} · Quality {g.quality} · Importance {g.importance}
          </p>
        </li>
      ))
    }
  </ul>

  <p class="mt-3 text-xs leading-relaxed text-slate-500 dark:text-slate-400">
    Quality is how good the matchup is for neutral viewers; importance is how much it moves
    playoff odds.
  </p>
</Base>