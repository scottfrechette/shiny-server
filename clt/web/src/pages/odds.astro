---
import Base from "../layouts/Base.astro";
import { latestWeek, loadWeekFile, pct } from "../lib/week";

type Proj = { Team: string; proj_wins: number; proj_pf: number; playoff_pct: number };

const { week } = latestWeek();
const teams = loadWeekFile<Proj[]>("projections").sort((a, b) => b.playoff_pct - a.playoff_pct);
---

<Base title="Odds · Charlotte's Finest">
  <header class="mb-4 flex items-baseline justify-between">
    <h1 class="text-lg font-semibold">Playoff odds</h1>
    <p class="text-xs text-slate-500 dark:text-slate-400">After week {week}</p>
  </header>

  <ol class="rounded-2xl bg-white p-4 shadow-sm dark:bg-slate-900">
    {
      teams.map((t) => (
        <li class="py-2">
          <div class="grid grid-cols-[5rem_1fr_3rem] items-center gap-3 text-sm">
            <span class="font-medium">{t.Team}</span>
            <span class="h-2.5 overflow-hidden rounded-full bg-slate-100 dark:bg-slate-800">
              <span
                class="block h-full rounded-full bg-indigo-500"
                style={`width:${Math.max(t.playoff_pct * 100, 1)}%`}
              />
            </span>
            <span class="text-right font-semibold tabular-nums">{pct(t.playoff_pct)}</span>
          </div>
          <p class="mt-0.5 pl-[5.75rem] text-xs text-slate-500 tabular-nums dark:text-slate-400">
            {t.proj_wins.toFixed(1)} wins · {Math.round(t.proj_pf).toLocaleString("en-US")} pts
          </p>
        </li>
      ))
    }
  </ol>

  <p class="mt-3 text-xs leading-relaxed text-slate-500 dark:text-slate-400">
    From the model's season simulations. Projected wins and points are full-season totals.
  </p>
</Base>
