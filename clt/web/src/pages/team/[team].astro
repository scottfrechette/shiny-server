---
import Base from "../../layouts/Base.astro";
import { int, latestWeek, loadWeekFile, ord, pct, signed, tryLoadWeekFile } from "../../lib/week";
import { slug } from "../../lib/teams";

export function getStaticPaths() {
  const rows = loadWeekFile<{ Team: string }[]>("rankings");
  return rows.map((r) => ({ params: { team: slug(r.Team) }, props: { team: r.Team } }));
}

type Rank = {
  Team: string;
  Record: string;
  FVOA: number;
  "FVOA Rank": number;
  "Yahoo Rank": number;
  "SOR Rank": number;
};
type Proj = { Team: string; proj_wins: number; proj_pf: number; playoff_pct: number };
type Lev = { Team: string; playoff_if_win: number; playoff_if_lose: number };
type Game = {
  winner: string;
  loser: string;
  winner_win_prob: number;
  loser_win_prob: number;
  spread: number;
};

const { team } = Astro.props as { team: string };
const { week } = latestWeek();

// Only this week's Read: an older one would contradict the tiles below it
const readData = tryLoadWeekFile<{ reads: Record<string, string> }>("read");
const read = readData?.reads?.[team];

const me = loadWeekFile<Rank[]>("rankings").find((r) => r.Team === team)!;
const projs = loadWeekFile<Proj[]>("projections");
const proj = projs.find((p) => p.Team === team);
const ptsRank = [...projs].sort((a, b) => b.proj_pf - a.proj_pf).findIndex((p) => p.Team === team) + 1;
const lev = loadWeekFile<Lev[]>("leverage").find((l) => l.Team === team);

// This week's game, from this team's point of view (null on a bye)
const game = loadWeekFile<Game[]>("matchups").find((g) => g.winner === team || g.loser === team);
const isWinner = game?.winner === team;
const opp = game ? (isWinner ? game.loser : game.winner) : null;
const myProb = game ? (isWinner ? game.winner_win_prob : game.loser_win_prob) : null;
const mySpread = game ? (isWinner ? game.spread : -game.spread) : null;
const spreadLabel =
  mySpread === null ? "" : mySpread === 0 ? "Pick'em" : `${team} ${mySpread > 0 ? "+" : ""}${mySpread}`;

// Chance of finishing in each position 1-10; top N make the playoffs
const spots = loadWeekFile<{ playoff_spots?: number }>("meta").playoff_spots ?? 4;
const oddsRow = loadWeekFile<Record<string, any>[]>("odds").find((o) => o.team === team);
const finish = Array.from({ length: 10 }, (_, i) => Number(oddsRow?.[String(i + 1)] ?? 0));
const maxFinish = Math.max(...finish, 0.0001);

const tiles = [
  { label: "Playoff odds", value: pct(proj?.playoff_pct ?? null), sub: `Top ${spots} make it` },
  { label: "Proj wins", value: proj ? proj.proj_wins.toFixed(1) : "–", sub: "Full season" },
  { label: "FVOA", value: signed(me.FVOA), sub: `${ord(me["FVOA Rank"])} strongest` },
  { label: "Proj points", value: proj ? int(proj.proj_pf) : "–", sub: `${ord(ptsRank)} in league` },
  { label: "Record", value: me.Record, sub: `${ord(me["Yahoo Rank"])} in Yahoo` },
  { label: "Strength of record", value: ord(me["SOR Rank"]), sub: "SOR rank" },
];
---

<Base title={`${team} · Charlotte's Finest`}>
  <main data-page-team={team}>
    <header class="mb-4 flex items-start justify-between">
      <div>
        <h1 class="text-xl font-semibold">{team}</h1>
        <p class="text-xs text-slate-500 dark:text-slate-400">After week {week}</p>
      </div>
      <div class="text-right text-xs">
        <button
          id="set-mine"
          hidden
          class="rounded-full bg-indigo-600 px-3 py-1 font-medium text-white"
        >
          This is my team
        </button>
        <p id="is-mine" hidden class="text-slate-500 dark:text-slate-400">
          Your team · <a href="/team?change" class="text-indigo-600 dark:text-indigo-400">Change</a>
        </p>
      </div>
    </header>

    {
      read && (
        <section class="mb-4 rounded-2xl bg-white p-4 shadow-sm dark:bg-slate-900">
          <h2 class="mb-2 text-sm font-semibold">The Read</h2>
          <p class="text-sm leading-relaxed text-slate-700 dark:text-slate-300">{read}</p>
        </section>
      )
    }

    <section class="mb-4 grid grid-cols-2 gap-3">
      {
        tiles.map((t) => (
          <div class="rounded-2xl bg-white p-3 shadow-sm dark:bg-slate-900">
            <p class="text-xs text-slate-500 dark:text-slate-400">{t.label}</p>
            <p class="text-2xl font-semibold tabular-nums">{t.value}</p>
            <p class="text-xs text-slate-500 dark:text-slate-400">{t.sub}</p>
          </div>
        ))
      }
    </section>

    <section class="mb-4 rounded-2xl bg-white p-4 shadow-sm dark:bg-slate-900">
      <h2 class="mb-2 text-sm font-semibold">This week</h2>
      {
        game && opp && myProb !== null ? (
          <>
            <p class="text-sm">
              {team} vs{" "}
              <a
                href={`/team/${slug(opp)}`}
                class="font-medium text-indigo-600 dark:text-indigo-400"
              >
                {opp}
              </a>
            </p>
            <div class="my-2 flex h-2 overflow-hidden rounded-full bg-slate-100 dark:bg-slate-800">
              <span class="bg-indigo-500" style={`width:${myProb * 100}%`} />
            </div>
            <div class="flex justify-between text-sm font-semibold tabular-nums">
              <span>{pct(myProb)}</span>
              <span>{pct(1 - myProb)}</span>
            </div>
            <p class="mt-2 text-xs text-slate-500 tabular-nums dark:text-slate-400">{spreadLabel}</p>
            {lev && (
              <p class="mt-3 text-xs text-slate-500 tabular-nums dark:text-slate-400">
                Playoff odds: {pct(lev.playoff_if_lose)} with a loss, {pct(lev.playoff_if_win)} with a win
              </p>
            )}
          </>
        ) : (
          <p class="text-sm text-slate-500 dark:text-slate-400">No game this week.</p>
        )
      }
    </section>

    <section class="rounded-2xl bg-white p-4 shadow-sm dark:bg-slate-900">
      <h2 class="mb-3 text-sm font-semibold">Where {team} finishes</h2>
      <div class="flex h-24 items-end gap-1" role="img" aria-label={`Chance of finishing in each position for ${team}`}>
        {
          finish.map((p, i) => (
            <div class="flex flex-1 flex-col items-center justify-end" title={`${ord(i + 1)}: ${pct(p)}`}>
              <span class="mb-0.5 h-3 text-[10px] leading-3 text-slate-500 tabular-nums dark:text-slate-400">
                {p >= 0.01 ? `${Math.round(p * 100)}%` : ""}
              </span>
              <div
                class:list={["w-full rounded-t", i < spots ? "bg-indigo-500" : "bg-slate-300 dark:bg-slate-700"]}
                style={`height:${Math.max((p / maxFinish) * 64, 2)}px`}
              />
            </div>
          ))
        }
      </div>
      <div class="mt-1 flex gap-1 text-xs text-slate-500 dark:text-slate-400">
        {finish.map((_, i) => <span class="flex-1 text-center">{i + 1}</span>)}
      </div>
      <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">
        Chance of finishing in each spot. Blue bars are playoff spots.
      </p>
    </section>
  </main>
</Base>

<script>
  const page = document.querySelector<HTMLElement>("[data-page-team]")!;
  const team = page.dataset.pageTeam!;
  const setBtn = document.querySelector<HTMLButtonElement>("#set-mine")!;
  const badge = document.querySelector<HTMLElement>("#is-mine")!;

  let saved: string | null = null;
  try {
    saved = localStorage.getItem("clt-team");
  } catch {}

  if (saved === team) badge.hidden = false;
  else setBtn.hidden = false;

  setBtn.addEventListener("click", () => {
    try {
      localStorage.setItem("clt-team", team);
    } catch {}
    setBtn.hidden = true;
    badge.hidden = false;
  });
</script>