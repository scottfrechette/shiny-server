---
import "../styles/global.css";

interface Props {
  title?: string;
}
const { title = "Charlotte's Finest" } = Astro.props;

// The tab bar only shows when there is more than one entry.
const nav = [
  { href: "/", label: "Home" },
  { href: "/week", label: "Week" },
  { href: "/rankings", label: "Rankings" },
  { href: "/team", label: "My Team" },
];
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#020617" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{title}</title>
  </head>
  <body class="bg-slate-50 text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
    <div
      class="mx-auto max-w-lg px-4 pt-[max(1rem,env(safe-area-inset-top))] pb-[calc(5rem+env(safe-area-inset-bottom))]"
    >
      <slot />
    </div>

    {
      nav.length > 1 && (
        <nav class="fixed inset-x-0 bottom-0 border-t border-slate-200 bg-white/90 pb-[env(safe-area-inset-bottom)] backdrop-blur dark:border-slate-800 dark:bg-slate-900/90">
          <ul class="mx-auto flex max-w-lg">
            {nav.map((item) => (
              <li class="flex-1">
                <a
                  href={item.href}
                  class:list={[
                    "block py-3 text-center text-xs font-medium",
                    (item.href === "/" ? path === "/" : path.startsWith(item.href))
                      ? "text-indigo-600 dark:text-indigo-400"
                      : "text-slate-500 dark:text-slate-400",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    <script>
      // Mark elements for the viewer's saved team; pages style them with data-[mine=true]:
      try {
        const mine = localStorage.getItem("clt-team");
        if (mine) {
          document.querySelectorAll<HTMLElement>("[data-team]").forEach((el) => {
            if (el.dataset.team === mine) el.dataset.mine = "true";
          });
        }
      } catch {}
    </script>
  </body>
</html>
